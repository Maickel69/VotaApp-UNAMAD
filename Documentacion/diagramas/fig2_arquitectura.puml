@startuml fig2_arquitectura
skinparam dpi 160
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam packageStyle rectangle

skinparam ArrowColor #1B4F72
skinparam ArrowThickness 1.2

package "CAPA DE PRESENTACIÓN (UI / Activities & Layouts XML)" #EBF5FB {
    class MainActivity {
        - llContenedorEncuestas : LinearLayout
        - btnCrearEncuesta : Button
        - rgFiltro : RadioGroup (Todas/Activas/Cerradas)
        - tvTotalEncuestas, tvActivasEncuestas, tvTotalVotos : TextView
        + cargarEncuestas() : void
        + mostrarDialogoEliminar(encuesta: Encuesta) : void
        .. Vistas XML ..
        activity_main.xml | item_encuesta.xml
    }
    
    class CrearEncuestaActivity {
        - etTituloEncuesta, etDescripcionEncuesta : EditText
        - rgCategoria : RadioGroup
        - swActiva : MaterialSwitch
        - btnGuardarYPreguntas, btnGuardarYVolver : Button
        + cargarDatosParaEdicion() : void
        + guardarEncuesta() : Long
        .. Vista XML ..
        activity_crear_encuesta.xml
    }
    
    class GestionarPreguntasActivity {
        - etTextoPregunta : EditText
        - rgTipoPregunta : RadioGroup
        - etAlternativa1 .. etAlternativa4 : EditText
        - llListaPreguntas : LinearLayout
        + cargarListaPreguntas() : void
        + guardarPregunta() : void
        + eliminarPregunta(id: Long) : void
        .. Vistas XML ..
        activity_gestionar_preguntas.xml | item_pregunta_gestion.xml
    }
    
    class RegistrarVotoActivity {
        - etParticipante : EditText
        - llContenedorPreguntasVoto : LinearLayout
        - mapaRadioGroups : HashMap<Long, RadioGroup>
        - mapaCheckBoxes : HashMap<Long, List<CheckBox>>
        + construirCuestionarioDinamico() : void
        + procesarVoto() : void
        .. Vista XML ..
        activity_registrar_voto.xml
    }
    
    class ResultadosActivity {
        - llResultadosPreguntas : LinearLayout
        - llListaParticipantes : LinearLayout
        - tvTotalParticipantes : TextView
        - btnReiniciarConteo, btnIrAVotar : Button
        + cargarResultados() : void
        + cargarGraficasPreguntas() : void
        + cargarListaVotantes() : void
        + mostrarDialogoReiniciarConteo() : void
        .. Vista XML ..
        activity_resultados.xml
    }
    
    MainActivity -[hidden]right-> CrearEncuestaActivity
    CrearEncuestaActivity -[hidden]right-> GestionarPreguntasActivity
    MainActivity -[hidden]down-> RegistrarVotoActivity
    RegistrarVotoActivity -[hidden]right-> ResultadosActivity
}

package "CAPA DE LÓGICA DE NEGOCIO Y MODELOS (Models.kt)" #E8F8F5 {
    class "Modelos de Dominio (Models.kt)" as Models {
        + Encuesta (id, titulo, desc, cat, activa, fecha, totalPreguntas, totalVotos)
        + Pregunta (id, idEncuesta, texto, tipo)
        + Alternativa (id, idPregunta, texto, votos)
        + Respuesta (id, idEncuesta, idPregunta, idAlternativa, participante, fechaVoto)
        + ParticipanteRegistro (nombre, fechaVoto)
        + AlternativaEstadistica (id, texto, votos, porcentaje, esGanadora)
        + PreguntaEstadistica (pregunta, totalVotosPregunta, alternativas)
    }
}

package "CAPA DE PERSISTENCIA Y DATOS (DatabaseHelper.kt)" #FEF9E7 {
    class DatabaseHelper {
        - DATABASE_NAME = "encuestas_unamad.db"
        - DATABASE_VERSION = 1
        .. Configuración ..
        + onConfigure(db): foreignKeyConstraintsEnabled = true
        + onCreate(db): DDL 4 tablas + insertarDatosIniciales()
        .. Operaciones CRUD Encuestas ..
        + crearEncuesta(titulo, desc, cat, activa): Long
        + actualizarEncuesta(id, titulo, desc, cat, activa): Boolean
        + eliminarEncuesta(id): Boolean [ON DELETE CASCADE]
        + obtenerEncuestaPorId(id): Encuesta?
        + listarEncuestas(filtro): List<Encuesta>
        + obtenerConteoGeneral(): Triple<Int, Int, Int>
        .. Operaciones CRUD Preguntas y Alternativas ..
        + insertarPreguntaConAlternativas(idE, texto, tipo, alts): Long
        + actualizarPreguntaConAlternativas(idP, texto, tipo, alts): Boolean
        + eliminarPregunta(idP): Boolean [CASCADE]
        + listarPreguntasDeEncuesta(idE): List<Pregunta>
        + listarAlternativasDePregunta(idP): List<Alternativa>
        + contarPreguntasDeEncuesta(idE): Int
        .. Operaciones Transaccionales Voto y Resultados ..
        + yaVotoParticipante(idE, participante): Boolean
        + registrarVotos(idE, participante, alternativas): Boolean
        + reiniciarVotosEncuesta(idE): Boolean
        + contarParticipantesUnicos(idE): Int
        + obtenerParticipantesDeEncuesta(idE): List<ParticipanteRegistro>
        + obtenerEstadisticasPreguntas(idE): List<PreguntaEstadistica>
    }
    
    class "SQLite Engine (encuestas_unamad.db)" as SQLiteEngine {
        + encuestas (id_encuesta PK, titulo, desc, cat, activa, fecha_creacion)
        + preguntas (id_pregunta PK, id_encuesta FK, texto_pregunta, tipo_pregunta)
        + alternativas (id_alternativa PK, id_pregunta FK, texto_alternativa, votos)
        + respuestas (id_respuesta PK, 3 FKs, participante, fecha_voto)
    }
}

MainActivity --> Models
CrearEncuestaActivity --> Models
GestionarPreguntasActivity --> Models
RegistrarVotoActivity --> Models
ResultadosActivity --> Models

MainActivity --> DatabaseHelper
CrearEncuestaActivity --> DatabaseHelper
GestionarPreguntasActivity --> DatabaseHelper
RegistrarVotoActivity --> DatabaseHelper
ResultadosActivity --> DatabaseHelper

DatabaseHelper --> SQLiteEngine : PRAGMA foreign_keys = ON\nTransacciones Atómicas (beginTransaction)
@enduml

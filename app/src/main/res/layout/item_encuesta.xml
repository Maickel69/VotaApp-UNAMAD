<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta individual para mostrar una encuesta en la lista de MainActivity -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila 1: Título y Badge de Estado (Activa / Cerrada) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvItemTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Título de la Encuesta"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/tvItemEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activa"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_badge_active"
                android:textColor="@color/success"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Fila 2: Categoría y Fecha de creación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvItemCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Satisfacción"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/bg_badge_category"
                android:textColor="@color/info" />

            <TextView
                android:id="@+id/tvItemFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-11-01 10:00"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <!-- Fila 3: Descripción de la encuesta -->
        <TextView
            android:id="@+id/tvItemDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción detallada de la encuesta para orientar al participante..."
            android:textSize="13.5sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="12dp" />

        <!-- Fila 4: Métricas rápidas -->
        <TextView
            android:id="@+id/tvItemInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3 Preguntas  •  4 Participantes"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/bg_info_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_marginBottom="12dp" />

        <!-- Fila 5: Acciones Principales (Votar y Resultados) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemVotar"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:text="Votar"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_vote"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/white"
                app:cornerRadius="10dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemResultados"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:text="Resultados"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_chart"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/primary"
                app:cornerRadius="10dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Fila 6: Acciones Secundarias (Editar y Eliminar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemEditar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:text="Editar"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_edit"
                app:iconSize="15dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/border_light"
                app:cornerRadius="10dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemEliminar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:text="Eliminar"
                android:textSize="12sp"
                android:textColor="@color/danger"
                android:maxLines="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_delete"
                app:iconSize="15dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/danger"
                app:strokeColor="@color/danger_border"
                app:cornerRadius="10dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

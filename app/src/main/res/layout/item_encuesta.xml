<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta individual Material 3 Expressive para mostrar una encuesta en MainActivity -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Fila 1: Chips de Categoría, Restricción de Acceso y Estado (Activa / Cerrada) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvItemCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Satisfacción"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_badge_category"
                android:textColor="@color/info" />

            <TextView
                android:id="@+id/tvItemAcceso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Padrón UNAMAD"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:drawablePadding="4dp"
                app:drawableStartCompat="@drawable/ic_lock"
                android:paddingStart="9dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_badge_restricted"
                android:textColor="@color/purple_badge"
                android:layout_marginStart="6dp"
                android:visibility="gone" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvItemEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activa"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_badge_active"
                android:textColor="@color/success"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Fila 2: Título principal con jerarquía tipográfica clara -->
        <TextView
            android:id="@+id/tvItemTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título de la Encuesta"
            android:textSize="17.5sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="6dp" />

        <!-- Fila 3: Descripción de la encuesta -->
        <TextView
            android:id="@+id/tvItemDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción detallada de la encuesta para orientar al participante..."
            android:textSize="13.5sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="3dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="10dp" />

        <!-- Fila 4: Autor y fecha -->
        <TextView
            android:id="@+id/tvItemFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2026-11-01 10:00 • Por Autor"
            android:textSize="11.5sp"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="12dp" />

        <!-- Fila 5: Franja tonal de métricas rápidas (Tabular Numerals) -->
        <TextView
            android:id="@+id/tvItemInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3 Preguntas  •  4 Participantes"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_surface_tonal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:layout_marginBottom="14dp" />

        <!-- Fila 6: Acciones Principales (48dp touch targets per Android MD3 guidelines) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemVotar"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Emitir Voto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_vote"
                app:iconSize="17dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/white"
                app:cornerRadius="12dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemResultados"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Resultados"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_chart"
                app:iconSize="17dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/primary"
                app:cornerRadius="12dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Fila 6: Acciones Secundarias (Editar y Eliminar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemEditar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:text="Editar"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_edit"
                app:iconSize="15dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/border_light"
                app:cornerRadius="10dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemEliminar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:text="Eliminar"
                android:textSize="12sp"
                android:textColor="@color/danger"
                android:maxLines="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_delete"
                app:iconSize="15dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/danger"
                app:strokeColor="@color/danger_border"
                app:cornerRadius="10dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
